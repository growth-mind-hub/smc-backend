{
  "name": "maxicab-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test",
    "db:migrate": "node --env-file=.env scripts/db-migrate.js",
    "admin:create": "node --env-file=.env scripts/create-admin.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
