NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Set loopback only when Nginx on the same machine is the sole ingress.
TRUST_PROXY=false
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/maxicab
# Set a strong secret; use only from your dashboard server, never public frontend code.
ADMIN_API_KEY=
# Browser admin credentials are stored in admin_users; run npm run admin:create.
# Server-side Google Maps key; enable Distance Matrix API (Legacy) and billing.
GOOGLE_MAPS_API_KEY=
# Stripe secrets stay on the backend. Use test credentials during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# HTTPS frontend URLs; local HTTP URLs work only outside production.
# Success can include ?session_id={CHECKOUT_SESSION_ID}.
STRIPE_SUCCESS_URL=https://singapore-maxicabs.vercel.app/payment-success
STRIPE_CANCEL_URL=https://singapore-maxicabs.vercel.app/payment-failed

# Meta WhatsApp Cloud API. Match the approved template's language and five body parameters.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_CONFIRMATION_TEMPLATE=booking_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en

# Persistent vehicle image directory; Node must have write access.
VEHICLE_UPLOAD_DIR=/var/lib/maxicab/uploads/vehicles
